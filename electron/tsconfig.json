{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "outDir": "../dist-electron",
        "rootDir": ".",
        "baseUrl": ".",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true
