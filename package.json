  "build": {
    "appId": "com.trellora.desktop",
    "productName": "Trellora",
    "extraMetadata": {
      "description": "Trellora"
    },
    "npmRebuild": false,
    "directories": {
      "output": "trellora"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/sqlite-vec-windows-x64/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sqlite-vec-windows-x64/**",
      "dist-electron/mammothWorker.js",
      "dist-electron/noteIndexWorker.js"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/pipeline-runtime",
        "to": "pipeline-runtime"
      },
      {
        "from": "build/builtin-skills",
        "to": "builtin-skills"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    }
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ]
  }
}
