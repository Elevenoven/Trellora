{
  "name": "trellora",
  "private": true,
  "version": "1.0.1",
  "description": "AI-native local-first Markdown knowledge management for Windows",
  "author": "Elevenoven",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Elevenoven/Trellora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elevenoven/Trellora.git"
  },
  "bugs": {
    "url": "https://github.com/Elevenoven/Trellora/issues"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "bindings": "^1.5.0",
    "d3-force": "^3.0.0",
    "docx-preview": "^0.4.0",
    "file-uri-to-path": "1.0.0",
    "mammoth": "1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react-force-graph-2d": "^1.29.1",
    "sqlite-vec-windows-x64": "0.1.9",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run build:electron && wait-on tcp:5173 && electron dist-electron/main.js\"",
    "build": "pnpm run build:icons && pnpm run build:pipeline-runtime && vite build && pnpm run build:electron && node scripts/build-windows-packages.mjs --publish never",
    "build:icons": "node scripts/generate-brand-icons.cjs",
    "build:pipeline-runtime": "node scripts/build-pipeline-runtime.mjs",
    "build:electron": "pnpm run ensure:native && esbuild electron/main.ts --bundle --platform=node --external:electron --external:better-sqlite3 --outfile=dist-electron/main.js && esbuild electron/knowledge/noteIndexWorker.ts --bundle --platform=node --outfile=dist-electron/noteIndexWorker.js && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.js && esbuild electron/externalWebPreload.ts --bundle --platform=node --external:electron --outfile=dist-electron/externalWebPreload.js && esbuild electron/pipeline/mammothWorker.ts --bundle --platform=node --outfile=dist-electron/mammothWorker.js && esbuild electron/workspaceMigrationWorker.ts --bundle --platform=node --external:better-sqlite3 --outfile=dist-electron/workspaceMigrationWorker.js && esbuild node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs --bundle --platform=node --format=esm --outfile=dist-electron/pdf.worker.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "ensure:native": "node scripts/ensure-electron-native.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:manifest": "node scripts/write-release-manifest.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.0.0",
    "@langchain/langgraph": "^1.4.9",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@replit/codemirror-lang-csharp": "^6.2.0",
    "@tiptap/core": "2.27.2",
    "@tiptap/extension-code-block-lowlight": "2.27.2",
    "@tiptap/extension-highlight": "^2.11.2",
    "@tiptap/extension-image": "2.27.2",
    "@tiptap/extension-link": "2.27.2",
    "@tiptap/extension-placeholder": "^2.11.2",
    "@tiptap/extension-table": "2.27.2",
    "@tiptap/extension-table-cell": "2.27.2",
    "@tiptap/extension-table-header": "2.27.2",
    "@tiptap/extension-table-row": "2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/react": "^2.11.2",
    "@tiptap/starter-kit": "^2.11.2",
    "@tiptap/suggestion": "2.27.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^4.3.0",
    "@xyflow/react": "^12.11.5",
    "chokidar": "4.0.3",
    "concurrently": "^8.2.2",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.11",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "electron-store": "^8.1.0",
    "elkjs": "^0.12.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eventsource-parser": "3.0.6",
    "globals": "^15.0.0",
    "iconv-lite": "0.6.3",
    "js-yaml": "4.3.2",
    "jsdom": "^29.1.1",
    "jszip": "3.10.1",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.474.0",
    "marked": "^15.0.1",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "11.16.1",
    "minisearch": "^7.1.1",
    "parse5": "8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-wiki-link": "^2.0.1",
    "sqlite-vec": "0.1.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^7.15.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.trellora.desktop",
    "productName": "Trellora",
    "extraMetadata": {
      "description": "Trellora"
    },
    "npmRebuild": false,
    "directories": {
      "output": "trellora"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/sqlite-vec-windows-x64/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sqlite-vec-windows-x64/**",
      "dist-electron/mammothWorker.js",
      "dist-electron/noteIndexWorker.js"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/pipeline-runtime",
        "to": "pipeline-runtime"
      },
      {
        "from": "build/builtin-skills",
        "to": "builtin-skills"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    }
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ]
  }
}
